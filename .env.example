# ── SpacetimeDB ───────────────────────────────────────────────────────────────
SPACETIMEDB_DB_NAME=pear-kara
# Public WebSocket URL the browser connects to (via Cloudflare Tunnel)
SPACETIMEDB_PUBLIC_URI=wss://spacetime.yourdomain.com
# Optional: same-origin proxy via the web app (single-route setup).
# Set this to your internal SpacetimeDB origin and set SPACETIMEDB_PUBLIC_URI to empty.
# Example:
# SPACETIMEDB_PUBLIC_URI=
# SPACETIMEDB_PROXY_ORIGIN=http://spacetimedb:3000
SPACETIMEDB_PROXY_ORIGIN=
# Identity token for the API gateway. Required for custom API endpoints (/api/e/*).
# Generate with: spacetime identity token --identity <your-identity>
# SPACETIMEDB_GATEWAY_TOKEN=

# ── Next.js (baked into the browser bundle at image build time) ───────────────
NEXT_PUBLIC_SPACETIMEDB_URI=wss://spacetime.yourdomain.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=pear-kara
# When Pear is embedded, set in the *host* app (see that app’s .env / next config).
# NEXT_PUBLIC_PEAR_AI_USER_API_BASE="/api/workspaces/{slug}/ai-users"
NEXT_PUBLIC_SPACETIMEAUTH_CLIENT_ID=
NEXT_PUBLIC_SPACETIMEAUTH_AUTHORITY=

# ── MinIO / S3-compatible blob storage ───────────────────────────────────────
# Defaults in docker-compose point the web app at the MinIO service.
# Override to use external storage (e.g. Cloudflare R2, AWS S3):
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_BUCKET=pear-attachments
#   S3_ACCESS_KEY=...
#   S3_SECRET_KEY=...
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
# Optional. Browser upload URL for presigned PUTs. If unset, the app uses the request host + :9000 (works with zero config when app and MinIO are on the same host). Set only when MinIO is on a different host or port.
# S3_PUBLIC_ENDPOINT=http://other-host:9000
S3_BUCKET=pear-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Orcha AI orchestration ────────────────────────────────────────────────────
# By default Orcha runs embedded in Pear's own SpacetimeDB module (zero config).
# Override to use a separate Orcha instance:
#   ORCHA_SPACETIMEDB_URI=wss://orcha.yourdomain.com
#   ORCHA_SPACETIMEDB_DB_NAME=orcha

# ── LLM Worker ────────────────────────────────────────────────────────────────
# Required to run the Pear LLM worker (pnpm worker / docker compose worker).
# The worker connects to SpacetimeDB, claims "llm" tasks, and calls Claude.
ANTHROPIC_API_KEY=
# Required for AI users to reply in conversations. The worker spawns one
# sub-connection per AI user (so messages are recorded as the AI user), which
# it discovers by reading each AI user's stored worker token from
# `ai_user_config`. That column — like AI-user API keys — is only visible to
# the module publisher, so the worker MUST connect as the publisher to see it.
# Set this to the publisher/owner identity token for your database:
#   spacetime token            # prints the logged-in identity's token
# Without it the worker runs anonymously: Orcha tasks still work, but AI users
# never answer chats (and structural sensors are skipped).
SPACETIMEDB_TOKEN=
# Optional overrides:
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ORCHA_AGENT_ID=pear-llm-worker
# Optional. When set, the worker's built-in `web_search` tool uses the Serper
# Google Search API (https://serper.dev) for all users. Per–AI-user keys can
# be set in workspace Settings → AI users instead. Not required for
# self-hosted: without Serper, search uses DuckDuckGo HTML.
# SERPER_API_KEY=

# ── Docker images (Forgejo container registry) ────────────────────────────────
# Used by deploy.sh to push, and by docker-compose on TrueNAS to pull.
WEB_IMAGE=forgejo.yourdomain.com/kara/pear-web:latest
# Derived automatically from WEB_IMAGE if unset (pear-web → pear-worker).
# WORKER_IMAGE=forgejo.yourdomain.com/kara/pear-worker:latest
