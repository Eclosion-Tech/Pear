{
  "name": "pear",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "pnpm": {
    "overrides": {
      "sharp": "^0.34.5",
      "@eclosion-tech/trellis": "file:vendor/trellis/eclosion-tech-trellis-0.1.0-alpha.3.tgz"
    }
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "generate": "pnpm --filter web generate",
    "worker": "pnpm --filter @pear/worker dev",
    "worker:generate": "pnpm --filter @pear/worker generate",
    "sentinel:test": "pnpm --filter @eclosion-tech/sentinel test",
    "mcp": "pnpm --filter @pear/worker mcp:http",
    "mcp:provision": "pnpm --filter @pear/worker mcp:provision",
    "desktop": "pnpm --filter @pear/desktop tauri:dev",
    "desktop:build": "pnpm --filter @pear/desktop tauri:build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  }
}
